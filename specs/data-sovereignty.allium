-- allium: 3
-- data-sovereignty.allium

use "./participant.allium" as participant
use "./research.allium" as research
use "./wellbeing.allium" as wellbeing

-- Scope: Participant data protection, selective export, end-to-end encryption, and safe deletion
-- Includes: Export selection flow, encrypted .sonda file production, deletion confirmation gates,
--           clear-all-data, withdrawal contact surface
-- Excludes:
--   - Participant consent and identity (see participant.allium)
--   - Research content and responses (see research.allium)
--   - Wellbeing tools (see wellbeing.allium)
-- Dependencies: Participant, ConsentRecord from participant.allium
--               Moment, Activity, Response from research.allium
--               FidgetSession from wellbeing.allium

-- Core principle: The participant's data belongs to the participant.
-- No data leaves the device without a deliberate, confirmed participant action.
-- There is no background synchronisation, analytics, or telemetry.

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value ExportSelection {
    bitacora: Boolean              -- Moments 1–11 responses (all activities)
    mensajeAlFuturo: Boolean       -- Closing moment (alwaysVisible) responses
    fidget: Boolean                -- FidgetSession logs (only if consent granted)
}
-- Default: all fields true. Participant may deselect any section.
-- Sections omitted from selection appear as { omitido: true } in the payload.

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DataSovereignty {
    @invariant NoSilentTransmission
        -- All data transmission requires an explicit, confirmed participant action.
        -- The system never initiates outbound network connections carrying
        -- participant data. No analytics, no telemetry, no passive sync.
        -- This invariant also applies to generative AI / LLM tools: no participant
        -- data (responses, media, fidget logs, or identifiers) may be sent to
        -- any AI service — neither by the app nor by the research team using
        -- the decryption tool — without a separate, specific ethics approval.

    @invariant DeviceStorageOnly
        -- All participant data (responses, consent record, sensory profile,
        -- fidget sessions) is stored exclusively on the participant's device,
        -- in IndexedDB (primary) and localStorage (boolean flags only).
        -- The system has no server-side storage component.

    @invariant ExportAlwaysConfirmed
        -- A data file is never created without a preceding explicit selection
        -- and confirmation from the participant in the same session.

    @invariant DeletionAlwaysConfirmed
        -- No response, momento record, or participant data is deleted without
        -- a preceding explicit confirmation from the participant.

    @invariant IrreversibilityMadeExplicit
        -- The clear-all-data action presents a clear, plain-language warning
        -- that the operation cannot be undone before asking for confirmation.

    @invariant ExportIsEncrypted
        -- Every exported data file is encrypted end-to-end using hybrid encryption
        -- (RSA-OAEP-256 wrapping a one-time AES-256-GCM session key) before it
        -- leaves the device. The decryption key is never stored in the app bundle
        -- or transmitted with the file. Only the designated researcher holding the
        -- private key can read the plaintext.
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Data export flow (select → create → share/download → email)

rule DataExportRequested {
    when: ParticipantRequestsExport(p)
    requires: p.status in {active, completed}
    ensures: ExportReviewPending(p)

    @guidance
        -- Data export is always available once the participant is active,
        -- regardless of study progression. Partial responses can be exported.
        -- Export is not gated on study completion.
        -- A participant with status withdrawn cannot request a new export
        -- (their data was cleared at withdrawal).
}

rule ExportSelectionReviewed {
    when: ParticipantSubmitsExportSelection(p, selection: ExportSelection)
    requires:
        ExportReviewPending(p)
        selection.bitacora or selection.mensajeAlFuturo or selection.fidget
    ensures: ExportFileCreating(p, selection)

    @guidance
        -- All three sections are selected by default. The participant may deselect
        -- any section before creating the file. At least one section must remain
        -- selected; the create button is disabled when none are checked.
        -- Deselected sections appear as { omitido: true } in the encrypted payload,
        -- not as absent keys, so the schema remains consistent for analysis tools.
        -- If fidget is selected but consent was denied, the fidget block in the
        -- payload will contain { omitido: true } regardless of the checkbox state.
}

rule DataExportCreated {
    when: ExportFileCreating(p, selection)
    ensures:
        EncryptedSondaFileReady(
            participant: p,
            filename: export_filename(p),       -- date-stamped, .sonda extension
            contents: encrypted_export(export_payload(p, selection))
        )
        ExportSharingPending(p)

    @guidance
        -- The export produces a single encrypted binary file with the .sonda extension.
        -- Encryption is hybrid: a fresh AES-256-GCM key encrypts the JSON payload;
        -- the AES key is then wrapped with the project's RSA-OAEP-256 public key
        -- (embedded in the app bundle — not secret). The resulting envelope contains:
        --   { schemaVersion, algorithm, keyId, encryptedKey (b64), iv (b64), ciphertext (b64) }
        -- Only the researcher holding the matching private key can decrypt it.
        --
        -- On iOS/Android (when navigator.canShare({ files }) is true):
        --   The share sheet opens immediately with the file attached.
        -- On desktop or unsupported browsers:
        --   The file is downloaded to the device and the participant is instructed
        --   to attach it manually when sending email.
}

rule DataExportShared {
    when: ParticipantSharesExportFile(p)
    ensures: ExportComplete(p)

    @guidance
        -- Sharing via the system share sheet (iOS/Android) or manual email attach
        -- (desktop) counts as export complete. The app transitions to a success state
        -- showing confirmation and an "Enviar por correo" mailto shortcut
        -- (pre-filled recipient and subject; participant attaches the file manually).
}

rule DataExportCancelled {
    when: ParticipantCancelsExport(p)
    ensures: not ExportReviewPending(p)

    @guidance
        -- No file is created and no data leaves the device.
        -- The app returns to the state before the export was requested.
}

-- Response deletion (two-step: request → confirm → delete)

rule ResponseDeletionRequested {
    when: ParticipantRequestsDeleteResponse(response)
    ensures: ResponseDeletionPending(response)
}

rule ResponseDeletionConfirmed {
    when: ParticipantConfirmsDeleteResponse(response)
    ensures: not exists response
}

rule ResponseDeletionCancelled {
    when: ParticipantCancelsDeleteResponse(response)
    ensures: ResponseDeletionPending(response)

    @guidance
        -- The response is preserved. No data is changed.
}

-- Clear all data (two-step: request → confirm → full wipe)

rule ClearAllDataRequested {
    when: ParticipantRequestsClearAllData(p)
    ensures: ClearAllDataConfirmationPending(p)
}

rule ClearAllDataConfirmed {
    when: ParticipantConfirmsClearAllData(p)
    ensures:
        for response in research/Responses where response.activity.moment.participant = p:
            not exists response
        for activity in research/Activities where activity.moment.participant = p:
            not exists activity
        for moment in research/Moments where moment.participant = p:
            not exists moment
        for session in wellbeing/FidgetSessions where session.participant = p:
            not exists session
        not exists p.consent
        not exists p

    @guidance
        -- After clearing, the application resets completely. On next launch,
        -- ParticipantInitialized fires as if it were a first-time user.
        -- This action is irreversible; there is no recovery path.
        -- The confirmation step must use plain language and avoid euphemisms.
        -- Both IndexedDB and localStorage are wiped.
}

rule ClearAllDataCancelled {
    when: ParticipantCancelsClearAllData(p)
    ensures: ClearAllDataConfirmationPending(p)

    @guidance
        -- All data is preserved. The app returns to its previous state.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ExportRequiresConsentedParticipant {
    for p in participant/Participants:
        p.status in {active, completed} implies p.has_consented
}

invariant FidgetExportRequiresConsent {
    for p in participant/Participants:
        ExportSelection.fidget = true implies p.fidget_telemetry_consent = granted
    -- If consent is denied, the fidget block is omitted regardless of checkbox state.
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor DataOwner {
    identified_by: participant/Participant where status in {active, completed}
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface ExportReviewSurface {
    facing owner: DataOwner

    provides:
        ParticipantSubmitsExportSelection(owner, selection: ExportSelection)
        ParticipantCancelsExport(owner)

    @guarantee SelectionIsVisible
        -- The participant sees what each section contains (response count for
        -- bitácora, count for mensajeAlFuturo, and a note about fidget consent
        -- gating) before committing to file creation.
    @guarantee AllSectionsDefaultSelected
        -- All three checkboxes begin checked; the participant opts out, not in.
    @guarantee AtLeastOneSectionRequired
        -- The create button is disabled when no section is selected.
}

surface DataManagementPanel {
    facing owner: DataOwner

    provides:
        ParticipantRequestsExport(owner)
        ParticipantRequestsClearAllData(owner)
        ParticipantConfirmsClearAllData(owner)
        ParticipantCancelsClearAllData(owner)

    contracts:
        fulfils DataSovereignty

    @guarantee ExportIsExplicit
        -- The participant initiates every export. The app never exports automatically
        -- in the background, on a schedule, or triggered by any system event.
    @guarantee ClearIsIrreversible
        -- The confirmation dialog for clear-all-data uses unambiguous language
        -- and does not offer a default-confirm interaction (e.g., auto-dismiss timer).
    @guidance
        -- The export button and clear-all-data option should be visually distinct
        -- to prevent accidental triggering.
}

surface ResponseDeletionConfirmation {
    facing owner: DataOwner
    context response: research/Response where response.activity.moment.participant = owner

    exposes:
        response.mode
        response.captured_at

    provides:
        ParticipantConfirmsDeleteResponse(response)
        ParticipantCancelsDeleteResponse(response)

    @guarantee DeletionIsExplicit
        -- The confirmation surface shows what is about to be deleted (response mode
        -- and capture date) so the participant can make an informed decision.
}

surface WithdrawalSurface {
    -- Defined in participant.allium (HelpModal withdrawal flow).
    -- Listed here as a cross-reference: withdrawal triggers ClearAllData as a
    -- downstream effect; data-sovereignty rules apply to that wipe.
    -- See participant/WithdrawalSurface for the full surface definition.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred export_filename
    -- Produces a date-stamped filename string with the .sonda extension.
    -- Format: sonda_YYYY-MM-DD_HHMMSS.sonda

deferred export_payload(p, selection: ExportSelection)
    -- Serialises participant data to JSON according to schema version 2.0.
    -- Sections not in selection appear as { omitido: true } in the envelope.
    -- Payload structure:
    --   { schemaVersion: "2.0", exportedAt, studyStartDate,
    --     bitacora: { ... } | { omitido: true },
    --     mensajeAlFuturo: { ... } | { omitido: true },
    --     fidget: { ... } | { omitido: true } }

deferred encrypted_export(payload_json)
    -- Wraps the JSON payload in a hybrid encryption envelope:
    --   1. Generate a one-time AES-256-GCM key and IV.
    --   2. Encrypt payload_json with AES-GCM.
    --   3. Wrap the AES key with the project RSA-OAEP-256 public key (keyId: sonda-v3-2026).
    --   4. Return: { schemaVersion, algorithm: "RSA-OAEP-256+AES-256-GCM",
    --               keyId, encryptedKey (b64), iv (b64), ciphertext (b64) }
    -- The private key is held exclusively by the researcher; it is never in the bundle.

deferred export_email_subject
    -- Produces the pre-filled email subject line for the researcher submission email.

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should the app prevent the operating system from backing up response data to cloud services (iCloud, Google Drive)? If so, how is this communicated to the participant and enforced technically?"
open question "Should a log of past export timestamps be maintained, so the participant can confirm they have successfully sent data to the researcher?"
open question "Should the export include the participant's SensoryProfile change history (if tracked) or only the current profile?"
