-- allium: 3
-- wellbeing.allium

use "./participant.allium" as participant

-- Scope: Wellbeing and sensory support tools
-- Includes: FidgetSession (interactive stress-relief tool), PWA installation guidance
-- Excludes:
--   - Sensory profile preferences (stored on Participant; managed in participant.allium)
--   - Research content (see research.allium)
--   - Data export (see data-sovereignty.allium)
-- Dependencies: Participant defined in participant.allium

-- The fidget tool provides a physics-based interactive toy for sensory regulation
-- and focus. Usage is always optional and never required. Sessions are logged
-- only if the participant explicitly grants telemetry consent on the
-- FidgetIntroductionView screen. Logged sessions are included in the data
-- export so researchers can understand self-regulation patterns over the study
-- period. The tool is always accessible and never gated by study progression.

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity FidgetSession {
    participant: participant/Participant
    status: active | ended
    started_at: Timestamp
    shots: Integer
    drags: Integer

    transitions status {
        active -> ended
        terminal: ended
    }

    ended_at: Timestamp when status = ended
    duration: ended_at - started_at when status = ended

    invariant NonNegativeCounts {
        shots >= 0 and drags >= 0
    }
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Session lifecycle

rule FidgetSessionStarted {
    when: ParticipantOpensFidgetTool(p)
    requires: p.status = active
    ensures:
        FidgetSession.created(
            participant: p,
            status: active,
            started_at: now,
            shots: 0,
            drags: 0
        )

    @guidance
        -- Only one fidget session per participant can be active at a time.
        -- (Enforced by the single-screen UI; the fidget tool occupies the
        -- full viewport while open.)
}

rule FidgetSessionEnded {
    when: ParticipantClosesFidgetTool(session, final_shots, final_drags)
    requires: session.status = active
    requires: session.participant.fidget_telemetry_consent = granted
    ensures:
        session.status = ended
        session.ended_at = now
        session.shots = final_shots
        session.drags = final_drags

    @guidance
        -- shots counts ball-release events with a drag distance above a minimum
        -- threshold (distinguishing intentional launches from brief touches).
        -- drags counts body-grab events (the player picking up a physics object).
        -- Both are accumulated in memory during the session and committed atomically
        -- on close, so no partial session data is persisted.
}

-- Fidget telemetry consent
-- NOTE: fidget_telemetry_consent (granted | denied) is a field on Participant,
-- defined in participant.allium. Rules here reference but do not declare it.

rule FidgetTelemetryConsentRevoked {
    when: ParticipantRevokesFidgetConsent(p)
    requires: p.status = active and p.fidget_telemetry_consent = granted
    ensures: p.fidget_telemetry_consent = denied

    @guidance
        -- Revocation is available from the SensorySettings screen (Preferencias).
        -- On revocation the participant is offered the option to delete
        -- accumulated fidget logs; see FidgetLogsDeletedOnRevocation.
}

rule FidgetLogsDeletedOnRevocation {
    when: ParticipantDeletesFidgetLogs(p)
    requires: p.status = active and p.fidget_telemetry_consent = denied
    ensures:
        for s in FidgetSessions where participant = p:
            not exists s

    @guidance
        -- Deletion is optional and offered at the moment of consent revocation.
        -- Once deleted, fidget session data cannot be recovered.
}

-- Fidget introduction (onboarding)

rule FidgetIntroCompleted {
    when: ParticipantCompletesFidgetIntro(p, consent_granted)
    requires: p.status = active and not p.fidget_intro_seen
    ensures:
        p.fidget_intro_seen = true
        if consent_granted:
            p.fidget_telemetry_consent = granted
        else:
            p.fidget_telemetry_consent = denied

    @guidance
        -- The participant must actively choose whether to allow fidget session
        -- logging before proceeding. Routing to the dashboard after this step
        -- is handled by the LaunchRouter in participant.allium.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ActiveSessionBelongsToActiveParticipant {
    for s in FidgetSessions:
        s.status = active implies s.participant.status = active
}

invariant FidgetSessionLoggedOnlyWithConsent {
    for s in FidgetSessions:
        s.status = ended implies s.participant.fidget_telemetry_consent = granted
}

invariant EndedSessionHasDuration {
    for s in FidgetSessions:
        s.status = ended implies s.ended_at >= s.started_at
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor ActiveParticipant {
    identified_by: participant/Participant where status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface FidgetToolView {
    facing player: ActiveParticipant

    exposes:
        player.sensory_profile.reduced_motion
        player.sensory_profile.theme

    provides:
        ParticipantOpensFidgetTool(player)
        ParticipantClosesFidgetTool(session, final_shots, final_drags)
            when session in FidgetSessions where participant = player and status = active

    @guarantee AlwaysAccessible
        -- The fidget tool is available at any point during the active study,
        -- regardless of research progress or which momentos are unlocked.
        -- It does not gate on, or affect, research progression.
    @guidance
        -- The tool uses a physics simulation with interactive objects (blocks and a
        -- projectile ball). Visual complexity and animation intensity should respect
        -- the participant's reduced_motion and theme sensory preferences.
        -- The tower of blocks regenerates automatically when all blocks have fallen,
        -- allowing indefinite play without interaction.
}

surface FidgetIntroductionView {
    facing player: ActiveParticipant

    provides:
        ParticipantCompletesFidgetIntro(player, consent_granted)
            when not player.fidget_intro_seen

    @guarantee ShowsOnce
        -- Shown exactly once, between the permissions screen and the dashboard,
        -- during PWA onboarding. Once fidget_intro_seen is true, this surface
        -- is never reached again.
    @guarantee ConsentIsExplicit
        -- The participant must actively choose whether to allow fidget session
        -- logging before proceeding. The "Continuar" button is disabled until
        -- a choice is made.
    @guidance
        -- The screen shows the fidget button (orbit icon, indigo circle) so the
        -- participant can recognise it later in the dashboard. Below the
        -- introduction, a consent block with two radio buttons asks whether the
        -- participant agrees to fidget session logging for research purposes.
        -- The choice is revocable later from Preferencias (SensorySettings).
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred PWAInstallation.prompt
    -- The PWA installation prompt is offered during the tutorial phase and
    -- optionally from the help panel. On iOS, it requires manual steps via
    -- the browser share menu. On Android/Chrome, a browser-native install
    -- prompt is triggered by the beforeinstallprompt event.
    -- Installation is never required and does not affect study participation.
    -- see: https://developer.mozilla.org/en-US/docs/Web/Progressive_web_apps

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should fidget sessions be logged when the app is in standalone (installed PWA) mode versus browser mode? Is the distinction meaningful for the research?"
-- Resolved: Fidget usage IS logged for research purposes to understand
-- self-regulation patterns, but using the tool is always optional and never
-- required. See the module header comment and FidgetSession entity.
open question "Should there be a maximum session duration after which the tool auto-closes and the session is recorded?"
